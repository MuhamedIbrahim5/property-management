# Database (Use PostgreSQL for production, SQLite for development)
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# Public Application URL (Required for QR codes and completion links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp Integration (Optional)
NEXT_PUBLIC_WHATSAPP_NUMBER="966501234567"

# Production Notes:
# 1. Use PostgreSQL DATABASE_URL from your provider (e.g., Supabase, Neon, PlanetScale)
# 2. Set NEXTAUTH_URL to your production domain (e.g., https://yourdomain.com)
# 3. Generate new NEXTAUTH_SECRET for production
# 4. Set NEXT_PUBLIC_APP_URL to match your production domain
